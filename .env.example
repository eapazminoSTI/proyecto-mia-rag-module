# Copia este archivo a .env y completa los valores antes de usar docker-compose.
# DATABASE_URL NO se define aquí: docker-compose.yml la arma automáticamente
# apuntando al servicio `db` (Postgres+pgvector) con las credenciales de abajo.

# N8N del pipeline original (host.docker.internal resuelve al host desde el contenedor
# en Docker Desktop; si N8N corre en otra máquina/túnel ngrok, usa esa URL directamente)
N8N_URL=http://host.docker.internal:5678
N8N_API_KEY=

OPENAI_API_KEY=

# Credenciales del Postgres+pgvector levantado por docker-compose (servicio `db`)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Opcionales — valores por defecto ya usados por rag/config.py
# RAG_EMBED_MODEL=text-embedding-3-small
# RAG_EMBED_DIM=1536
# RAG_LLM_MODEL=gpt-4o-mini
